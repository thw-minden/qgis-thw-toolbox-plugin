        <ComposerMapGrid annotationExpression="-- volle Kilometer: hochgestellte Vorziffern + zweistellige km-Zahl&#10;-- 100-m-Zwischenlinien: nur die 100-m-Ziffer&#10;with_variable('v', to_int(round(@grid_number)),&#10;with_variable('h', to_int(floor(@v/100)%10),&#10;  if(@h = 0,&#10;     with_variable('hi', to_int(floor(@v/100000)),&#10;       if(@hi &gt;= 10, array_get(string_to_array('⁰,¹,²,³,⁴,⁵,⁶,⁷,⁸,⁹'), to_int(floor(@hi/10))), '')&#10;       || array_get(string_to_array('⁰,¹,²,³,⁴,⁵,⁶,⁷,⁸,⁹'), to_int(@hi%10))&#10;     )&#10;     || lpad(to_string(to_int(floor(@v/1000)%100)), 2, '0'),&#10;     to_string(@h)&#10;  )&#10;))" annotationFormat="8" annotationPrecision="4" blendMode="0" bottomAnnotationDirection="0" bottomAnnotationDisplay="0" bottomAnnotationPosition="1" bottomFrameDivisions="0" crossLength="2.12143000000000015" frameAnnotationDistance="0.707143" frameFillColor1="255,255,255,255,rgb:1,1,1,1" frameFillColor2="0,0,0,255,rgb:0,0,0,1" gridFrameMargin="0" gridFramePenColor="0,0,0,255,rgb:0,0,0,1" gridFramePenThickness="0.28285700000000003" gridFrameSideFlags="15" gridFrameStyle="1" gridFrameWidth="1.41429000000000005" gridStyle="3" intervalX="100" intervalY="100" leftAnnotationDirection="0" leftAnnotationDisplay="0" leftAnnotationPosition="1" leftFrameDivisions="0" maximumIntervalWidth="100" minimumIntervalWidth="50" name="1km" offsetX="0" offsetY="0" position="0" rightAnnotationDirection="0" rightAnnotationDisplay="0" rightAnnotationPosition="1" rightFrameDivisions="0" rotatedAnnotationsEnabled="0" rotatedAnnotationsLengthMode="0" rotatedAnnotationsMarginToCorner="0" rotatedAnnotationsMinimumAngle="0" rotatedTicksEnabled="0" rotatedTicksLengthMode="0" rotatedTicksMarginToCorner="0" rotatedTicksMinimumAngle="0" show="1" showAnnotation="1" topAnnotationDirection="0" topAnnotationDisplay="0" topAnnotationPosition="1" topFrameDivisions="0" unit="0" uuid="{a8bb702f-677e-4987-83b6-cf5c6cc019d7}">
