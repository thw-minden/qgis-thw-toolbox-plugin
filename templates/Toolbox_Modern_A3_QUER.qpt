 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="0" id="Meridiankonvergenz" itemRotation="0" labelText="Kartenmitte: [% with_variable('g', transform(centroid(map_get(item_variables('Hauptkarte'), 'map_extent')), map_get(item_variables('Hauptkarte'), 'map_crs'), 'EPSG:4326'), with_variable('z', floor((x(@g) + 180) / 6) + 1, with_variable('c', transform(@g, 'EPSG:4326', 'EPSG:' || to_string(32600 + @z)), to_string(@z) || substr('CDEFGHJKLMNPQRSTUVWX', floor((y(@g) + 80) / 8) + 1, 1) || ' ' || substr(array_get(array('STUVWXYZ', 'ABCDEFGH', 'JKLMNPQR'), @z % 3), floor(x(@c) / 100000), 1) || substr('ABCDEFGHJKLMNPQRSTUV', (floor(y(@c) / 100000) + if(@z % 2 = 0, 5, 0)) % 20 + 1, 1) || ' ' || lpad(to_string(floor((x(@c) % 100000) / 100)), 3, '0') || ' ' || lpad(to_string(floor((y(@c) % 100000) / 100)), 3, '0')))) %]&#xa;Nordpfeil: Geographisch Nord&#xa;Gitternord weicht ab um [% with_variable('g', transform(centroid(map_get(item_variables('Hauptkarte'), 'map_extent')), map_get(item_variables('Hauptkarte'), 'map_crs'), 'EPSG:4326'), with_variable('z', floor((x(@g) + 180) / 6) + 1, with_variable('k', degrees(atan(tan(radians(x(@g) - (@z * 6 - 183))) * sin(radians(y(@g))))), if(@k >= 0, '+', '−') || replace(format_number(abs(@k), 2), '.', ',') || '°'))) %]" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="100.783,278.75,mm" positionLock="false" positionOnPage="100.783,278.75,mm" referencePoint="0" size="72.6881,12.25,mm" templateUuid="{dd885c6a-4191-4435-bef0-81f22ef81d7d}" type="65641" uuid="{dd885c6a-4191-4435-bef0-81f22ef81d7d}" valign="32" visibility="1" zValue="30">
